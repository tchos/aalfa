{% extends 'base.html.twig' %}

{% block title %}STATS GLOBALES PAR AGENT DE SAISIE  AU {{ "now"|date("d/m/Y") }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('asset/css/dataTables.dataTables.css') }}">
{% endblock %}

{% block contenttitle %}Statistiques globales des saisies !{% endblock %}

{% block aside %}
    {% include '_partials/_aside.html.twig' with {
        'cpteurDailyUser': compteurUserJour,
        'cpteurUser': compteurUser,
        'totalSaisie': totalSaisie
    } %}
{% endblock %}

{% block body %}
    {% include '_partials/_globalstat.html.twig' with {'stats': stats } %}
    <div class="row">
        <div class="col-sm-9 mx-auto">
            <table id="globalstats" class="display compact" style="width:100%">
                <thead>
                <tr>
                    <th class="text-center">Rang</th>
                    <th>Nom complet</th>
                    <th class="text-center">Nbre fiches de collecte </th>
                    <th class="text-center">Nombre actes saisis</th>
                </tr>
                </thead>
                <tbody>
                {% set i = 1 %}
                {% for user in globalUserStats %}
                    <tr>
                        <td class="text-center">{{ i }}</td>
                        {% if i == 1 %}
                            <td><img src="{{ asset('asset/images/medal_gold.png') }}" width="20px" class="pe-1" alt=""> {{ user.fullname }}</td>
                        {% elseif i == 2 %}
                            <td><img src="{{ asset('asset/images/medal_silver.png') }}" width="20px" class="pe-1" alt=""> {{ user.fullname }}</td>
                        {% elseif i == 3 %}
                            <td><img src="{{ asset('asset/images/medal_bronze.png') }}" width="20px" class="pe-1" alt=""> {{ user.fullname }}</td>
                        {% else %}
                            <td>{{ user.fullname }}</td>
                        {% endif %}
                        <td class="text-center">{{ user.nb_acte | number_format(0,'.',' ') }}</td>
                        <td class="text-center">{{ user.nb_enfant | number_format(0,'.',' ') }}</td>
                    </tr>
                    {% set i = i + 1 %}
                {% else %}
                    <span class="fw-bolder text-primary">Aucune saisie n'a encore été effectuée ce jour.</span>
                {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <th class="text-center">Total</th>
                        <th></th>
                        <th class="text-center"></th>
                        <th class="text-center"></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('asset/js/dataTables.bootstrap5.js') }}"></script>
    <script src="{{ asset('asset/js/jquery-3.7.1.js') }}"></script>
    <script src="{{ asset('asset/js/dataTables.js') }}"></script>

    <script src="{{ asset('asset/js/dataTables.buttons.js') }}"></script>
    <script src="{{ asset('asset/js/buttons.dataTables.js') }}"></script>
    <script src="{{ asset('asset/js/jszip.min.js') }}"></script>
    <script src="{{ asset('asset/js/pdfmake.min.js') }}"></script>
    <script src="{{ asset('asset/js/vfs_fonts.js') }}"></script>
    <script src="{{ asset('asset/js/buttons.html5.min.js') }}"></script>
    <script src="{{ asset('asset/js/buttons.print.min.js') }}"></script>
    <script>
        $(document).ready(function(){
            new DataTable('#globalstats', {
                layout: {
                    topStart: {
                        pageLength: true,
                        buttons: [
                            {
                                extend: 'copy',
                                text: '<i class="fa fa-copy"></i> Copier',
                                className: 'btn btn-secondary btn-sm'
                            },
                            {
                                extend: 'csv',
                                text: '<i class="fa fa-file-csv"></i> CSV',
                                className: 'btn btn-info btn-sm'
                            },
                            {
                                extend: 'excel',
                                text: '<i class="fa fa-file-excel"></i> Excel',
                                className: 'btn btn-success btn-sm'
                            },
                            {
                                extend: 'pdf',
                                text: '<i class="fa fa-file-pdf"></i> PDF',
                                className: 'btn btn-danger btn-sm',
                                orientation: 'landscape',
                                pageSize: 'A4',

                                customize: function (doc) {

                                    // Marges
                                    doc.pageMargins = [20, 20, 20, 20];

                                    // Taille de police
                                    doc.defaultStyle.fontSize = 9;

                                    // Entête du tableau
                                    doc.styles.tableHeader.fontSize = 10;
                                    doc.styles.tableHeader.bold = true;
                                    doc.styles.tableHeader.alignment = 'center';

                                    // Nombre de colonnes
                                    var nbCols = doc.content[1].table.body[0].length;

                                    // Les colonnes occupent toute la largeur de la page
                                    doc.content[1].table.widths = Array(nbCols).fill('*');

                                    // Arranger le tableau
                                    var body = doc.content[1].table.body;

                                    for (var i = 0; i < body.length; i++) {

                                        // Rang
                                        body[i][0].alignment = 'center';

                                        // Noms
                                        body[i][1].alignment = 'left';

                                        // Equipe
                                        body[i][2].alignment = 'center';

                                        // Nombre agents recensés
                                        body[i][3].alignment = 'center';
                                    }
                                }
                            },
                            {
                                extend: 'print',
                                text: '<i class="fa fa-print"></i> Imprimer',
                                className: 'btn btn-dark btn-sm'
                            }
                        ]
                    }
                },
                footerCallback: function () {

                    let api = this.api();

                    // Colonnes numériques
                    [2,3].forEach(function(col){

                        let total = api
                            .column(col,{page:'current'})
                            .data()
                            .reduce(function(a,b){

                                a = Number(
                                    a.toString()
                                        .replace(/\s/g,'')
                                        .replace(',','.')
                                ) || 0;

                                b = Number(
                                    b.toString()
                                        .replace(/\s/g,'')
                                        .replace(',','.')
                                ) || 0;

                                return a+b;

                            },0);

                        $(api.column(col).footer()).html(
                            '<strong>'+total.toLocaleString('fr-FR')+'</strong>'
                        );

                    });

                    $(api.column(0).footer()).html('<strong>TOTAL</strong>');

                    let total = [];

                    total.push({
                        text:'TOTAL',
                        bold:true,
                        alignment:'center'
                    });

                    total.push({
                        text:'',
                    });

                    [2,3].forEach(function(col){

                        let somme = 0;

                        for(let i=1;i<body.length;i++){

                            somme += parseFloat(
                                body[i][col].text
                                    .toString()
                                    .replace(/\s/g,'')
                            ) || 0;

                        }

                        total.push({
                            text:somme.toLocaleString('fr-FR'),
                            bold:true,
                            alignment:'center'
                        });

                    });

                    body.push(total);
                }
            });
        });
    </script>
{% endblock %}