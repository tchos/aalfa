{% extends 'base.html.twig' %}

{% block title %}LISTE DES ENFANTS DU CEC{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('asset/css/dataTables.dataTables.css') }}">
{% endblock %}

{% block contenttitle %}Liste des enfants du Centre d'Etat Civil de {{ cec.libelleCec }}({{ cec.codeCec }}){% endblock %}

{% block bouton %}{% endblock %}

{% block aside %}
    {% include '_partials/_aside.html.twig' with {
        'cpteurDailyUser': compteurUserJour,
        'cpteurUser': compteurUser,
        'totalSaisie': totalSaisie
    } %}
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col">
            <div class="card border-primary mb-3" style="max-width: 18rem;">
                <div class="card-header">
                    <div class="row">
                        <div class="col-9"><p class="card-text">Agents recensés: </p></div>
                        <div class="col"><span class="badge text-bg-primary">{{ stats.nbAgentRecense | number_format(0,'.',' ') }}</span></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-primary mb-3" style="max-width: 18rem;">
                <div class="card-header">
                    <div class="row">
                        <div class="col-9"><p class="card-text">Enfant validés: </p></div>
                        <div class="col"><span class="badge text-bg-primary">{{ stats.nbActeNaissance | number_format(0,'.',' ') }}</span></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-primary mb-3" style="max-width: 18rem;">
                <div class="card-header">
                    <div class="row">
                        <div class="col-9"><p class="card-text">Utilisateurs inscrits: </p></div>
                        <div class="col"><span class="badge text-bg-primary">{{ stats.nbUsers | number_format(0,'.',' ') }}</span></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-primary mb-3" style="max-width: 18rem;">
                <div class="card-header">
                    <div class="row">
                        <div class="col-9"><p class="card-text">Equipes inscrites: </p></div>
                        <div class="col"><span class="badge text-bg-primary">{{ stats.nbEquipes | number_format(0,'.',' ') }}</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <hr class="mb-3">
    <div class="row">
        <div class="col-sm-9 mx-auto">
            <table id="cecstats" class="display compact" style="width:100%">
                <thead>
                <tr>
                    <th class="text-center">Ordre</th>
                    <th class="text-start">Matricule du parent</th>
                    <th class="text-start">Nom de l'enfant</th>
                    <th class="text-center">Date de naissance</th>
                    <th class="text-center">Numéro acte</th>
                    <th class="text-center">Rang</th>
                    <th class="text-center">Nom du conjoint</th>
                </tr>
                </thead>
                <tbody>
                {% set i = 1 %}
                {% for enfant in enfants %}
                    <tr>
                        <td class="text-center">{{ i }}</td>
                        <td class="text-start">{{ enfant.matricule }}</td>
                        <td class="text-start">{{ enfant.nomEnfant }}</td>
                        <td class="text-center">{{ enfant.dateNaissance | date('Y-m-d') }}</td>
                        <td class="text-center">{{ enfant.numeroActe }}</td>
                        <td class="text-center">{{ enfant.rang }}</td>
                        <td class="text-center">{{ enfant.nomConjoint }}</td>
                    </tr>
                    {% set i = i + 1 %}
                {% else %}
                    <span class="fw-bolder text-primary">Aucune saisie n'a encore été effectuée ce jour.</span>
                {% endfor %}
                </tbody>
                <tfoot>
                <tr>
                    <th class="text-center">Ordre</th>
                    <th class="text-start">Matricule du parent</th>
                    <th class="text-start">Nom de l'enfant</th>
                    <th class="text-center">Date de naissance</th>
                    <th class="text-center">Numéro acte</th>
                    <th class="text-center">Rang</th>
                    <th class="text-center">Nom du conjoint</th>
                </tr>
                </tfoot>
            </table>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('asset/js/dataTables.bootstrap5.js') }}"></script>
    <script src="{{ asset('asset/js/jquery-3.7.1.js') }}"></script>
    <script src="{{ asset('asset/js/dataTables.js') }}"></script>

    <script src="{{ asset('asset/js/dataTables.buttons.js') }}"></script>
    <script src="{{ asset('asset/js/buttons.dataTables.js') }}"></script>
    <script src="{{ asset('asset/js/jszip.min.js') }}"></script>
    <script src="{{ asset('asset/js/pdfmake.min.js') }}"></script>
    <script src="{{ asset('asset/js/vfs_fonts.js') }}"></script>
    <script src="{{ asset('asset/js/buttons.html5.min.js') }}"></script>
    <script src="{{ asset('asset/js/buttons.print.min.js') }}"></script>
    <script>
        $(document).ready(function(){
            new DataTable('#cecstats', {
                layout: {
                    topStart: {
                        pageLength: true,
                        buttons: [
                            {
                                extend: 'copy',
                                text: '<i class="fa fa-copy"></i> Copier',
                                className: 'btn btn-secondary btn-sm'
                            },
                            {
                                extend: 'csv',
                                text: '<i class="fa fa-file-csv"></i> CSV',
                                className: 'btn btn-info btn-sm'
                            },
                            {
                                extend: 'excel',
                                text: '<i class="fa fa-file-excel"></i> Excel',
                                className: 'btn btn-success btn-sm'
                            },
                            {
                                extend: 'pdf',
                                text: '<i class="fa fa-file-pdf"></i> PDF',
                                className: 'btn btn-danger btn-sm',
                                orientation: 'landscape',
                                pageSize: 'A4'
                            },
                            {
                                extend: 'print',
                                text: '<i class="fa fa-print"></i> Imprimer',
                                className: 'btn btn-dark btn-sm'
                            }
                        ]
                    }
                }
            });
        });
    </script>
{% endblock %}