{% extends 'base.html.twig' %}

{% block title %}Enfant{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('asset/auto_tabx/jquery-ui-1.10.0.custom.css') }}" />
    <link rel="stylesheet" href="{{ asset('asset/auto_tabx/ajax.css') }}" />
{% endblock %}

{% block contenttitle %}Mettre à jour un enfant{% endblock %}

{% block aside %}
    {% include '_partials/_aside.html.twig' with {
        'cpteurDailyUser': compteurUserJour,
        'cpteurUser': compteurUser,
        'totalSaisie': totalSaisie
    } %}
{% endblock %}

{% block bouton %}
    <a class="btn btn-primary btn-sm" href="{{ path('app_agent_show', {'id': idAgent}) }}"
       role="button">Revenir à Liste des enfants de {{ matriculeAgent }}
    </a>
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">
                {{ message|raw }}
            </div>
        {% endfor %}
    {% endfor %}
    {{ form_start(form) }}
        <div class="row">
            <div class="col-8">{{ form_row(form.nom_enfant) }}</div>
            <div class="col">{{ form_row(form.date_naissance) }}</div>
        </div>
        <div class="row">
            <div class="col">{{ form_row(form.code_cec) }}</div>
            <div class="col">{{ form_row(form.numero_acte) }}</div>
            <div class="col">{{ form_row(form.date_acte_naissance) }}</div>
        </div>
        <div class="row">
            {# <div class="col">{{ form_row(form.nom_conjoint) }}</div> #}
            <div class="col">{{ form_row(form.handicapeYN) }}</div>
        </div>
        <div class="row">
            <div class="mt-3">

                {{ form_widget(form.Enregistrer) }}

                <a href="{{ path('app_agent_show', {'id': idAgent}) }}"
                   class="btn btn-sm btn-secondary">
                    <i class="fa fa-ban" aria-hidden="true"></i>
                    Annuler
                </a>

            </div>
        </div>
    {{ form_end(form) }}
{% endblock %}
{% block javascripts %}
    <script src="{{ asset('asset/auto_tabx/jquery-1.9.0.js') }}"></script>
    <script src="{{ asset('asset/auto_tabx/jquery-ui-1.10.0.custom.js') }}"></script>
    <script type="text/javascript">
        $(document).ready(function(){
            $("#enfant_code_cec").autocomplete({
                minLength: 3,
                delay: 1,
                source: '{{ asset('asset/auto_tabx/auto_cec.php') }}'
            });
            $('#enfant_code_cec').change(function() {
                this.value=this.value.toUpperCase();
                return;
            });
        });
    </script>
{% endblock %}
