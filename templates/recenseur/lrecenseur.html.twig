{% extends 'base.html.twig' %}

{% block title %}Liste équipes{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('asset/css/dataTables.dataTables.css') }}">
{% endblock %}

{% block aside %}
    {% include '_partials/_aside.html.twig' with {'cpteurDailyUser':compteurUserJour, 'cpteurUser':compteurUser} %}
{% endblock %}

{% block contenttitle %}Liste des équipes de collecte{% endblock %}

{% block bouton %}
    <a class="btn btn-primary btn-sm" href="{{ path('app_recenseur_new') }}" role="button">Nouvel agent de collecte</a>
{% endblock %}

{% block body %}
    <table id="listerecenseurs" class="display compact" style="width:100%">
        <thead>
        <tr>
            <th class="text-start">N°</th>
            <th>Matricule</th>
            <th class="text-start">Nom</th>
            <th class="text-start">Code</th>
            <th class="text-start">Equipe</th>
            <th class="text-start">Chef</th>
            <th class="text-center">Action</th>
        </tr>
        </thead>
        <tbody>
        {% set i = 1 %}
        {% for recenseur in recenseurs %}
            <tr>
                <td class="text-start">{{ i }}</td>
                <td>{{ recenseur.matricule }}</td>
                <td class="text-start">{{ recenseur.nom }}</td>
                <td class="text-start">{{ recenseur.code }}</td>
                <td class="text-start">{{ recenseur.equipe.libelle }}</td>
                <td class="text-start">{{ recenseur.equipe.chef }}</td>
                <td class="text-center">
                    <a href="{{ path('app_recenseur_edit', {'id': recenseur.id}) }}" class="text-primary me-2">
                        <i class="fa-regular fa-pen-to-square"></i></a>
                    <a href="{{ path('app_equipe_delete', {'id': recenseur.id}) }}" class="text-danger">
                        <i class="fa-regular fa-rectangle-xmark"></i></a>
                </td>
            </tr>
            {% set i = i + 1 %}
        {% endfor %}
        </tbody>
        <tfoot>
        <tr>
            <th class="text-start">N°</th>
            <th>Matricule</th>
            <th class="text-start">Nom</th>
            <th class="text-start">Code</th>
            <th class="text-start">Equipe</th>
            <th class="text-start">Chef</th>
            <th class="text-center">Action</th>
        </tr>
        </tfoot>
    </table>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('asset/js/dataTables.bootstrap5.js') }}"></script>
    <script src="{{ asset('asset/js/jquery-3.7.1.js') }}"></script>
    <script src="{{ asset('asset/js/dataTables.js') }}"></script>
    <script>
        $(document).ready(function(){
            new DataTable('#listerecenseurs');
        });
    </script>
{% endblock %}
