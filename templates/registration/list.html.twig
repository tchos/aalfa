{% extends 'base.html.twig' %}

{% block title %}Liste utilisateurs{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('asset/css/dataTables.dataTables.css') }}">
{% endblock %}

{% block aside %}
    {% include '_partials/_aside.html.twig' with {
        'cpteurDailyUser': compteurUserJour,
        'cpteurUser': compteurUser,
        'totalSaisie': totalSaisie
    } %}
{% endblock %}

{% block contenttitle %}Liste des utilisateurs{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">
                {{ message|raw }}
            </div>
        {% endfor %}
    {% endfor %}
    <table id="listeusers" class="display compact" style="width:100%">
        <thead>
            <tr>
                <th class="text-start">N°</th>
                <th>Nom complet</th>
                <th class="text-start">Téléphones</th>
                <th class="text-start">Dernière connexion</th>
                <th class="text-start">Action</th>
            </tr>
        </thead>
        <tbody>
            {% set i = 1 %}
            {% for user in users %}
                <tr>
                    <td class="text-start">{{ i }}</td>
                    <td>{{ user.fullname }}</td>
                    <td class="text-start">{{ user.telephone }}</td>
                    <td class="text-start">{{ user.dateDerniereConnexion|date('d-m-Y  H:i:s') }}</td>
                    <td class="text-start">
                        Modifier Supprimer
                        <a href="{{ path('app_user_reset_password', {'id': user.id}) }}"
                           class="btn btn-warning btn-sm"
                           onclick="return confirm('Voulez-vous vraiment réinitialiser le mot de passe de cet utilisateur ?');">
                            <i class="fas fa-key"></i>
                            Réinitialiser
                        </a>
                    </td>
                </tr>
                {% set i = i + 1 %}
            {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <th class="text-start">N°</th>
                <th>Nom complet</th>
                <th class="text-start">Téléphones</th>
                <th class="text-start">Dernière connexion</th>
                <th class="text-start">Action</th>
            </tr>
        </tfoot>
    </table>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('asset/js/dataTables.bootstrap5.js') }}"></script>
    <script src="{{ asset('asset/js/jquery-3.7.1.js') }}"></script>
    <script src="{{ asset('asset/js/dataTables.js') }}"></script>

    <script src="{{ asset('asset/js/dataTables.buttons.js') }}"></script>
    <script src="{{ asset('asset/js/buttons.dataTables.js') }}"></script>
    <script src="{{ asset('asset/js/jszip.min.js') }}"></script>
    <script src="{{ asset('asset/js/pdfmake.min.js') }}"></script>
    <script src="{{ asset('asset/js/vfs_fonts.js') }}"></script>
    <script src="{{ asset('asset/js/buttons.html5.min.js') }}"></script>
    <script src="{{ asset('asset/js/buttons.print.min.js') }}"></script>
    <script>
        $(document).ready(function(){
            new DataTable('#listeusers', {
                layout: {
                    topStart: {
                        pageLength: true,
                        buttons: [
                            {
                                extend: 'copy',
                                text: '<i class="fa fa-copy"></i> Copier',
                                className: 'btn btn-secondary btn-sm'
                            },
                            {
                                extend: 'csv',
                                text: '<i class="fa fa-file-csv"></i> CSV',
                                className: 'btn btn-info btn-sm'
                            },
                            {
                                extend: 'excel',
                                text: '<i class="fa fa-file-excel"></i> Excel',
                                className: 'btn btn-success btn-sm'
                            },
                            {
                                extend: 'pdf',
                                text: '<i class="fa fa-file-pdf"></i> PDF',
                                className: 'btn btn-danger btn-sm',
                                orientation: 'landscape',
                                pageSize: 'A4'
                            },
                            {
                                extend: 'print',
                                text: '<i class="fa fa-print"></i> Imprimer',
                                className: 'btn btn-dark btn-sm'
                            }
                        ]
                    }
                }
            });
        });
    </script>
{% endblock %}
