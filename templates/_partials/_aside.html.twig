<div class="col-sm-2 mx-2">
    <div class="card border-primary mb-3" style="max-width: 18rem;">
        <div class="card-header">Statistiques globales des saisies</div>
        <div class="card-body text-primary">
            {% if globalUserStats[0] is defined %}
                <div class="row">
                    <div class="col-8"><p class="card-text">1er: {{ globalUserStats[0].fullname|split(' ')|first }}</p></div>
                    <div class="col"><span class="badge text-bg-success">{{ globalUserStats[0].nb_enfant | number_format(0,'.',' ') }}</span></div>
                </div>
                <hr>
            {% endif %}
            {% if globalUserStats[1] is defined %}
                <div class="row">
                    <div class="col-8"><p class="card-text">2ème: {{ globalUserStats[1].fullname|split(' ')|first }}</p></div>
                    <div class="col"><span class="badge text-bg-success">{{ globalUserStats[1].nb_enfant | number_format(0,'.',' ') }}</span></div>
                </div>
                <hr>
            {% endif %}
            {% if globalUserStats[2] is defined %}
                <div class="row">
                    <div class="col-8"><p class="card-text">3ème: {{ globalUserStats[2].fullname|split(' ')|first }}</p></div>
                    <div class="col"><span class="badge text-bg-success">{{ globalUserStats[2].nb_enfant | number_format(0,'.',' ') }}</span></div>
                </div>
            {% endif %}
            <hr>
            <div class="row">
                <div class="col-8"><p class="card-text">Vous: </p></div>
                <div class="col"><span class="badge text-bg-dark">{{ cpteurUser | number_format(0,'.',' ') }}</span></div>
            </div>
            <hr>
            <div class="row">
                <div class="col-8"><p class="card-text">Total: </p></div>
                <div class="col"><span class="badge text-bg-dark">{{ totalSaisie | number_format(0,'.',' ') }}</span></div>
            </div>
        </div>
    </div>
    {% if dailyUserStats %}
        <div class="card border-primary mb-3" style="max-width: 18rem;">
            <div class="card-header">Statistiques Journalières des saisies</div>
            <div class="card-body text-primary">
                <div class="row">
                    <div class="col-8"><p class="card-text">1er: {{ dailyUserStats[0].fullname }} </p></div>
                    <div class="col"><span class="badge text-bg-primary">{{ dailyUserStats[0].nb_enfant | number_format(0,'.',' ') }}</span></div>
                </div>
                {% if dailyUserStats[1] is defined %}
                    <hr>
                    <div class="row">
                        <div class="col-8"><p class="card-text">2ème: {{ dailyUserStats[1].fullname }} </p></div>
                        <div class="col"><span class="badge text-bg-primary">{{ dailyUserStats[1].nb_enfant | number_format(0,'.',' ') }}</span></div>
                    </div>
                {% endif %}
                {% if dailyUserStats[2] is defined %}
                    <hr>
                    <div class="row">
                        <div class="col-8"><p class="card-text">3ème: {{ dailyUserStats[2].fullname }} </p></div>
                        <div class="col"><span class="badge text-bg-primary">{{ dailyUserStats[2].nb_enfant | number_format(0,'.',' ') }}</span></div>
                    </div>
                {% endif %}
                <hr>
                <div class="row">
                    <div class="col-8"><p class="card-text">Vous: </p></div>
                    <div class="col"><span class="badge text-bg-dark">{{ cpteurDailyUser | number_format(0,'.',' ') }}</span></div>
                </div>
                <hr>
                <div class="row">
                    <div class="col-8"><p class="card-text">Total du jour: </p></div>
                    <div class="col"><span class="badge text-bg-danger">{{ totalActeJour | number_format(0,'.',' ') }}</span></div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="card border-primary mb-3" style="max-width: 18rem;">
            <div class="card-header">Statistiques Journalières des saisies</div>
            <div class="card-body text-primary">
                <div class="row">
                    <div class="col-8"><p class="card-text">1er: </p></div>
                    <div class="col"><span class="badge text-bg-primary">{{ 0 | number_format(0,'.',' ') }}</span></div>
                </div>
                <hr>
                <div class="row">
                    <div class="col-8"><p class="card-text">Vous: </p></div>
                    <div class="col"><span class="badge text-bg-dark">{{ cpteurDailyUser | number_format(0,'.',' ') }}</span></div>
                </div>
                <hr>
                <div class="row">
                    <div class="col-8"><p class="card-text">Total du jour: </p></div>
                    <div class="col"><span class="badge text-bg-danger">{{ totalActeJour | number_format(0,'.',' ') }}</span></div>
                </div>
            </div>
        </div>
    {% endif %}
    <hr class="d-sm-none">
</div>
