{% extends 'base.html.twig' %}

{% block title %}Agent index{% endblock %}

{% block contenttitle %}Nouvelle fiche de collecte{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('asset/auto_tabx/jquery-ui-1.10.0.custom.css') }}" />
    <link rel="stylesheet" href="{{ asset('asset/auto_tabx/ajax.css') }}" />
{% endblock %}

{% block aside %}
    {% include '_partials/_aside.html.twig' with {'cpteurDailyUser':compteurUserJour, 'cpteurUser':compteurUser} %}
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        <div class="alert alert-{{ label }}">
            {% for message in messages %}
                {{ message|raw }}
            {% endfor %}
        </div>
    {% endfor %}
    {{ form_start(form) }}
        <div class="row">
            {{ form_errors(form.matricule) }}
            <div class="col-sm-6">
                {{ form_widget(form.matricule) }}
            </div>
            <div class="col-sm">
                {{ form_row(form.submit) }}
            </div>
        </div>
    {{ form_end(form) }}

    {# Au cas où l'on trouve l'agent #}
    {% if agent %}
        <hr class="my-5 border-primary">
        <table class="table table-striped table-hover" name="parent">
            <thead>
                <tr>
                    <th scope="col">Matricule</th>
                    <th scope="col">Nom complet</th>
                    <th scope="col" class="text-center">Naissance</th>
                    <th scope="col" class="text-center">Date Emb.</th>
                    <th scope="col" class="text-center">Enfts payés</th>
                    <th scope="col" class="text-center">Téléphones</th>
                    <th scope="col" class="text-center">Recenseur</th>
                    <th scope="col" class="text-center">Enfts Collectés</th>
                    <th scope="col" class="text-center">Fiche</th>
                    <th scope="col" class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">{{ agent.matricule }}</th>
                    <td>{{ agent.nomAgt }}</td>
                    <td class="text-center">{{ agent.dateNaisAgt|date('d-m-Y') }}</td>
                    <td class="text-center">{{ agent.dateEmbAgt|date('d-m-Y') }}</td>
                    <td class="text-center">{{ agent.NbEnftPaye }}</td>
                    <td class="text-center">{{ agent.telephone }}</td>
                    <td class="text-center">{{ agent.recenseur ? agent.recenseur.code : '-' }}</td>
                    <td class="text-center">{{ agent.NbEnftCollecte }}</td>
                    <td class="text-center">
                        {% if ficheCollecte %}
                            <a href="{{ asset('asset/fiches_collecte/' ~ ficheCollecte) }}"
                               title="Fiche de collecte de {{ agent.nomAgt }}" target="_blank">
                                <img src="{{ asset("asset/images/pdf_file_icon.png") }}" alt="{{ agent.matricule }}" width="20px">
                            </a>
                        {% else %}
                            <img src="{{ asset("asset/images/pdf_black.png") }}" title="La fichier de collecte est indisponible" width="22px">
                        {% endif %}
                    </td>
                    <td class="text-center">
                        {% if agent.saisieTerminee == false %}
                            {# <a href="{{ path('app_agent_edit', {'id': agent.id}) }}">edit</a> #}
                            <!-- Button to Open the Modal -->
                            <button href="{{ path('app_agent_edit', {'id': agent.id}) }}" type="button" class="btn btn-sm btn-primary"
                                    data-bs-toggle="modal" data-bs-target="#editAgent" data-id="{{ agent.id }}">
                                Modifier l'agent
                            </button>
                        {% else %}
                            <button class="btn btn-sm btn-secondary" disabled>
                                Saisie validée
                            </button>
                            {% if is_granted('ROLE_ADMIN') %}
                                <button
                                        type="button"
                                        class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#enable-{{ agent.id }}">
                                    Déverrouiller
                                </button>
                                <div class="modal fade"
                                     id="enable-{{ agent.id }}"
                                     tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header bg-warning">
                                                <h5 class="modal-title">
                                                    Attention
                                                </h5>
                                                <button type="button"
                                                        class="btn-close"
                                                        data-bs-dismiss="modal">
                                                </button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="alert alert-danger">
                                                    <strong>
                                                        Attention !
                                                    </strong>

                                                    Vous êtes sur le point de déverrouiller la saisie !
                                                    <hr>
                                                    Si vous continuez,
                                                    la validation sera annulée.
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button"
                                                        class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                    Non, erreur
                                                </button>
                                                <a href="{{ path('app_agent_enable', {'id': agent.id}) }}"
                                                   class="btn btn-danger">
                                                    Oui, Déverrouiller
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        {% endif %}

                        <!-- La fenêtre modale qui affichera le formulaire -->
                        <div class="modal" id="editAgent">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">

                                    <!-- Modal Header -->
                                    <div class="modal-header">
                                        <h4 class="modal-title">Modifier les infos de l'agent</h4>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>

                                    <!-- Modal body -->
                                    <div class="modal-body text-start">
                                        {{render(controller('App\\Controller\\AgentController::edit',{'id': agent.id})) }}
                                    </div>

                                    <!-- Modal footer -->
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-sm btn-dark" data-bs-dismiss="modal">Close</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
        {% if agent.recenseur and agent.recenseur.code and agent.telephone and agent.nbEnftCollecte %}
            <div class="row mx-1">
                <span class="text-bg-dark fw-bolder text-center mt-5">Enfants payés au fichier solde</span>
            </div>
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th scope="col">Noms</th>
                        <th scope="col-1">Naissance</th>
                        <th scope="col-1">N° Acte Nais.</th>
                        <th scope="col">Date Acte Nais.</th>
                        <th scope="col" class="text-center">Reconnu (O/N) ?</th>
                        <th scope="col" class="text-center">Handicapé (O/N) ?</th>
                        <th scope="col-1" class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for enfant in agent.enfants %}
                        <tr>
                            <td>{{ enfant.nomEnfant }}</td>
                            <td>{{ enfant.dateNaissance|date('d-m-Y') }}</td>
                            <td>{{ enfant.numeroActe }}</td>
                            <td>
                                {% if enfant.dateActeNaissance  %}
                                    {{ enfant.dateActeNaissance|date('d-m-Y') }}
                                {% endif %}
                            </td>
                            <td class="text-center">{% if enfant.isEnfantReconnuYN == false %}NON{% else  %}OUI{% endif %}</td>
                            <td class="text-center">{% if enfant.isHandicapeYN == false %}NON{% else  %}OUI{% endif %}</td>
                            <td class="text-center">
                                {% if enfant.isEnfantReconnuYN == true %}
                                    <button
                                            type="button"
                                            class="btn btn-sm btn-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalAnnulerSaisie">
                                        Annuler
                                    </button>
                                    <div class="modal fade"
                                         id="modalAnnulerSaisie"
                                         tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header bg-warning">
                                                    <h5 class="modal-title">
                                                        Attention
                                                    </h5>
                                                    <button type="button"
                                                            class="btn-close"
                                                            data-bs-dismiss="modal">
                                                    </button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="alert alert-danger">
                                                        <strong>
                                                            Attention !
                                                        </strong>

                                                        Vous êtes sur le point d'annuler cet enfant ?
                                                        <hr>
                                                        Si vous continuez,
                                                        la saisie sera définitivement annulée.
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button"
                                                            class="btn btn-secondary"
                                                            data-bs-dismiss="modal">
                                                        Non, erreur
                                                    </button>
                                                    <a href="{{ path('app_enfant_reinitialisersaisie', {'id': enfant.id}) }}"
                                                       class="btn btn-danger">
                                                        Oui, Annuler
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <a href="{{ path('app_enfant_show', {'id': enfant.id}) }}"
                                       class="btn btn-sm btn-primary">
                                        Details
                                    </a>
                                    {#
                                        <button href="{{ path('app_enfant_edit', {'id': enfant.id}) }}" type="button"
                                                class="btn btn-sm btn-primary"
                                                data-bs-toggle="modal" data-bs-target="#editEnfant-{{ enfant.id }}" data-id="{{ enfant.id }}">
                                            Voir
                                            {% set i = enfant.id %}
                                        </button>
                                    #}
                                {% endif %}
                                {% if agent.saisieTerminee == false %}
                                    <a href="{{ path('app_enfant_edit', {'id': enfant.id}) }}"
                                       class="btn btn-sm btn-{% if enfant.isEnfantReconnuYN == false %}warning{% else %}success{% endif %}">
                                        {% if enfant.isEnfantReconnuYN == true %}Modifier{% else %}Renseigner{% endif %}
                                    </a>
                                {% else %}
                                    <button class="btn btn-sm btn-secondary" disabled>
                                        Saisie validée
                                    </button>
                                {% endif %}
                                {#
                                <!-- La fenêtre modale qui affichera le formulaire -->
                                <div class="modal" id="editEnfant-{{ enfant.id }}">
                                    <div class="modal-dialog modal-lg">
                                        <div class="modal-content">

                                            <!-- Modal Header -->
                                            <div class="modal-header bg-success">
                                                <h4 class="modal-title fw-bolder">Informations sur l'enfant {{ enfant.nomEnfant }}</h4>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>

                                            <!-- Modal body -->
                                            <div class="modal-body text-start">
                                                {{render(controller('App\\Controller\\EnfantController::show',{'id': enfant.id})) }}
                                            </div>

                                            <!-- Modal footer -->
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-sm btn-dark" data-bs-dismiss="modal">Close</button>
                                            </div>
                                        </div>
                                    </div>
                                </div> #}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <div class="mt-4">
                {% if agent.saisieTerminee == false %}
                    <button
                            type="button"
                            class="btn btn-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#modalTerminerSaisie">

                        <i class="fa fa-lock"></i>
                        Terminer la saisie
                    </button>
                    <div class="modal fade"
                         id="modalTerminerSaisie"
                         tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header bg-warning">
                                    <h5 class="modal-title">
                                        Attention
                                    </h5>
                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal">
                                    </button>
                                </div>

                                <div class="modal-body">
                                    {% set totalCollecte = agent.nbEnftCollecte %}
                                    {% set totalRenseigne = agent.nbEnfantsRenseignes %}
                                    {% if totalRenseigne < totalCollecte %}
                                        <div class="alert alert-danger">
                                            <strong>
                                                Attention !
                                            </strong>

                                            Seulement
                                            {{ totalRenseigne }}
                                            enfant(s) renseigné(s)
                                            sur
                                            {{ totalCollecte }}.
                                            <hr>
                                            Si vous continuez,
                                            la saisie sera définitivement verrouillée.
                                        </div>
                                    {% else %}
                                        <div class="alert alert-success">
                                            Tous les enfants ont été renseignés.
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="modal-footer">
                                    <button type="button"
                                            class="btn btn-secondary"
                                            data-bs-dismiss="modal">
                                        Continuer les saisies
                                    </button>
                                    <a href="{{ path(
                                        'app_agent_terminer_saisie',
                                        {'id': agent.id}
                                    ) }}"
                                       class="btn btn-danger">
                                        Oui, terminer
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
                {#
                {% if agent.saisieTerminee == false %}
                    <a href="{{ path('app_agent_terminer_saisie', {'id': agent.id}) }}"
                       class="btn btn-danger">
                        Terminer la saisie
                    </a>
                {% else %}
                    <a href="{{ path('app_agent_index') }}"
                       class="btn btn-sm btn-success">
                        Nouvelle fiche de collecte
                    </a>
                {% endif %}
                #}
            </div>
        {% else %}
            <div class="row mx-1">
                <span class="text-bg-danger fw-bolder text-center mt-5">
                    Vous devez mettre à jour les informations de l'agent telles que portées sur la fiche de collecte
                </span>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('asset/auto_tabx/jquery-1.9.0.js') }}"></script>
    <script src="{{ asset('asset/auto_tabx/jquery-ui-1.10.0.custom.js') }}"></script>
    <script type="text/javascript">
        $(document).ready(function(){
            $("#search_agent_matricule").autocomplete({
                minLength: 5,
                delay: 1,
                source: '{{ asset('asset/auto_tabx/auto_mat.php') }}'
            });
            $('#search_agent_matricule').change(function() {
                this.value=this.value.toUpperCase();
                return;
            });
        });
    </script>
    <script>
        let totalCollecte = {{ totalCollecte|default(0) }};
        let totalRenseigne = {{ totalRenseigne|default(0) }};

        window.addEventListener('beforeunload', function (e) {

            if (totalRenseigne < totalCollecte) {
                e.preventDefault();

                e.returnValue = 'Tous les enfants collectés ne sont pas encore renseignés.';

            }
        });
    </script>
{% endblock %}

