{% extends 'base.html.twig' %}

{% block title %}Equipe{% endblock %}

{% block contenttitle %}NouvelLe équipe{% endblock %}

{% block aside %}
    {% include '_partials/_aside.html.twig' with {
        'cpteurDailyUser': compteurUserJour,
        'cpteurUser': compteurUser,
        'totalSaisie': totalSaisie
    } %}
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">
                {{ message|raw }}
            </div>
        {% endfor %}
    {% endfor %}
    {{ form_start(form) }}
        <div class="row">
            <div class="col-md-4 form-control-sm">{{ form_row(form.libelle) }}</div>
            <div class="col-md-4 form-control-sm">{{ form_row(form.code) }}</div>
        </div>
        <div class="row form-control-sm">

        </div>
        <div class="row">
            <div class="col-md-4 form-control-sm">{{ form_row(form.chef) }}</div>
            <div class="col-md-4 form-control-sm">{{ form_row(form.coordonnateur) }}</div>
        </div>

        <button type="submit" class="btn btn-sm btn-primary"><i class="fa-regular fa-floppy-disk"></i> Enregistrer</button>
        <a class="btn btn-sm btn-dark" href="{{ path('app_equipe_list') }}"><i class="fa-solid fa-ban"></i> Annuler</a>
    {{ form_end(form) }}
{% endblock %}
