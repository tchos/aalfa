{% extends 'base.html.twig' %}

{% block title %}Liste équipes{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('asset/css/dataTables.dataTables.css') }}">
{% endblock %}

{% block aside %}
    {% include '_partials/_aside.html.twig' with {
        'cpteurDailyUser': compteurUserJour,
        'cpteurUser': compteurUser,
        'totalSaisie': totalSaisie
    } %}
{% endblock %}

{% block contenttitle %}Liste des équipes de collecte{% endblock %}

{% block bouton %}
    <a class="btn btn-primary btn-sm" href="{{ path('app_equipe_new') }}" role="button">Nouvelle équipe</a>
{% endblock %}

{% block body %}
    <table id="listeequipes" class="display compact" style="width:100%">
        <thead>
            <tr>
                <th class="text-start">N°</th>
                <th>Libellé</th>
                <th class="text-start">Code</th>
                <th class="text-start">Chef</th>
                <th class="text-start">Coordonnadeur</th>
                <th class="text-center">Action</th>
            </tr>
        </thead>
        <tbody>
            {% set i = 1 %}
            {% for equipe in equipes %}
                <tr>
                    <td class="text-start">{{ i }}</td>
                    <td class="text-start">{{ equipe.libelle }}</td>
                    <td class="text-start">{{ equipe.code }}</td>
                    <td class="text-start">{{ equipe.chef }}</td>
                    <td class="text-start">{{ equipe.coordonnateur }}</td>
                    <td class="text-center">
                        <a href="{{ path('app_equipe_edit', {'id': equipe.id}) }}" class="text-primary me-2">
                            <i class="fa-regular fa-pen-to-square"></i></a>
                        <a href="{{ path('app_equipe_delete', {'id': equipe.id}) }}" class="text-danger">
                            <i class="fa-regular fa-rectangle-xmark"></i></a>
                    </td>
                </tr>
                {% set i = i + 1 %}
            {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <th class="text-start">N°</th>
                <th class="text-start">Libellé</th>
                <th class="text-start">Code</th>
                <th class="text-start">Chef</th>
                <th class="text-start">Coordonnadeur</th>
                <th class="text-center">Action</th>
            </tr>
        </tfoot>
    </table>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('asset/js/dataTables.bootstrap5.js') }}"></script>
    <script src="{{ asset('asset/js/jquery-3.7.1.js') }}"></script>
    <script src="{{ asset('asset/js/dataTables.js') }}"></script>

    <script src="{{ asset('asset/js/dataTables.buttons.js') }}"></script>
    <script src="{{ asset('asset/js/buttons.dataTables.js') }}"></script>
    <script src="{{ asset('asset/js/jszip.min.js') }}"></script>
    <script src="{{ asset('asset/js/pdfmake.min.js') }}"></script>
    <script src="{{ asset('asset/js/vfs_fonts.js') }}"></script>
    <script src="{{ asset('asset/js/buttons.html5.min.js') }}"></script>
    <script src="{{ asset('asset/js/buttons.print.min.js') }}"></script>
    <script>
        $(document).ready(function(){
            new DataTable('#listeequipes', {
                layout: {
                    topStart: {
                        pageLength: true,
                        buttons: [
                            {
                                extend: 'copy',
                                text: '<i class="fa fa-copy"></i> Copier',
                                className: 'btn btn-secondary btn-sm'
                            },
                            {
                                extend: 'csv',
                                text: '<i class="fa fa-file-csv"></i> CSV',
                                className: 'btn btn-info btn-sm'
                            },
                            {
                                extend: 'excel',
                                text: '<i class="fa fa-file-excel"></i> Excel',
                                className: 'btn btn-success btn-sm'
                            },
                            {
                                extend: 'pdf',
                                text: '<i class="fa fa-file-pdf"></i> PDF',
                                className: 'btn btn-danger btn-sm',
                                orientation: 'landscape',
                                pageSize: 'A4'
                            },
                            {
                                extend: 'print',
                                text: '<i class="fa fa-print"></i> Imprimer',
                                className: 'btn btn-dark btn-sm'
                            }
                        ]
                    }
                }
            });
        });
    </script>
{% endblock %}
